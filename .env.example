# Copy to .env.local. Both are safe for the client: every table is behind row-level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Domain used to turn a plain username into the Supabase Auth email.
# "team" signs in as team@<domain>, "admin" as admin@<domain>. Never receives mail.
EXPO_PUBLIC_LOGIN_DOMAIN=invictus.app
